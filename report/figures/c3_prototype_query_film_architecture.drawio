        </mxCell>
        <mxCell id="crossattn" value="&lt;b&gt;Cross-Attention&lt;/b&gt;&lt;br&gt;Q=P, K=V=H&lt;sub&gt;stat&lt;/sub&gt;&lt;br&gt;O=Attn(P,H,H)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;strokeWidth=1.2;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="940" y="125" width="180" height="90" as="geometry"/>

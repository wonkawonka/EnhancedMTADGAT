        <mxCell id="queries" value="&lt;b&gt;K Learnable Queries&lt;/b&gt;&lt;br&gt;P = [p&lt;sub&gt;1&lt;/sub&gt;, …, p&lt;sub&gt;K&lt;/sub&gt;]&lt;br&gt;orthogonal initialization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;strokeWidth=1.2;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1">

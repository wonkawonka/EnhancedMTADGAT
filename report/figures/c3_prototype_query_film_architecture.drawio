        </mxCell>
        <mxCell id="state" value="&lt;b&gt;Continuous Regime State&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;proto&lt;/sub&gt; = Σ q&lt;sub&gt;k&lt;/sub&gt;o&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;z&lt;sub&gt;res&lt;/sub&gt; = Wg − z&lt;sub&gt;proto&lt;/sub&gt;&lt;br&gt;z = MLP[g,z&lt;sub&gt;proto&lt;/sub&gt;,z&lt;sub&gt;res&lt;/sub&gt;,q]&lt;br&gt;&lt;b&gt;z ∈ R&lt;sup&gt;8&lt;/sup&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;strokeWidth=1.2;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1390" y="105" width="220" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="film" value="&lt;b&gt;Fusion-FiLM(z)&lt;/b&gt;&lt;br&gt;[γ,β] = Linear(z)&lt;br&gt;H̃ = H ⊙ (1+0.1γ) + 0.1β" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1">

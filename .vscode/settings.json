{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],
    "chat.useAgentSkills": true,
    "chat.agentSkillsLocations": {
        ".vscode/skills": true
    },
    "git.ignoreLimitWarning": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/index": true,
        "**/.venv/**": true,
        "**/.python312-runtime/**": true,
        "**/datasets/**": true,
        "**/runs/**": true,
        "**/checkpoints/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.ipynb_checkpoints/**": true
    },
    "git.terminalAuthentication": true,
    "git.sshCommand": "ssh -i /home/chenmj/.ssh/id_ed25519_github",
    "search.exclude": {
        "**/datasets/**": true,
        "**/runs/**": true,
        "**/__pycache__/**": true,
        "**/.ipynb_checkpoints/**": true
    },
    "python.analysis.exclude": [
        "**/datasets/**",
        "**/runs/**",
        "**/__pycache__/**"
    ]
}

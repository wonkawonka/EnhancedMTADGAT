{
  "plan_name": "04_msl_external_baselines",
  "_thesis_role": "MSL 外部模型对照：TranAD、Anomaly Transformer、GDN 与 DCdetector。",
  "_protocol": "所有模型读取项目中同一份 MSL train/test/label。主表统一报告未进行 point adjustment 的逐点 AP/AUROC；各模型保留其论文推荐优化策略和训练轮数。",
  "common_env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUNBUFFERED": "1",
    "MPLBACKEND": "Agg",
    "MPLCONFIGDIR": "/tmp/matplotlib"
  },
  "experiments": [
    {
      "name": "tranad_msl",
      "baseline": "TranAD",
      "script": "main.py",
      "flags": ["retrain"],
      "args": {
        "dataset": "MSL",
        "model": "TranAD"
      }
    },
    {
      "name": "anomaly_transformer_msl",
      "baseline": "Anomaly-Transformer",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/msl_external",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 32,
        "win_size": 100,
        "anormly_ratio": 4.0
      }
    },
    {
      "name": "gdn_msl",
      "baseline": "GDN",
      "script": "main.py",
      "args": {
        "-dataset": "msl",
        "-device": "cuda",
        "-epoch": 10,
        "-batch": 128,
        "-slide_win": 15,
        "-slide_stride": 5,
        "-save_path_pattern": "msl_external"
      }
    },
    {
      "name": "dcdetector_msl",
      "baseline": "DCdetector",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/msl_external",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 128,
        "win_size": 100,
        "patch_size": "[5]",
        "anormly_ratio": 4.0,
        "lr": 0.0001
      }
    }
  ]
}

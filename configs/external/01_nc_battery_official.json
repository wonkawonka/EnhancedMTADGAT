{
  "plan_name": "01_nc_battery_official",
  "_lifecycle": "archived_brand3_replaced_by_unified_07_08",
  "_thesis_role": "历史电池外部对照计划；Brand3 已移至统一 runner 的 07/08，禁止从本计划重跑或引用。",
  "_protocol": "本计划只保留 Brand1/2 历史兼容运行。Brand3 的唯一可执行外部对比协议为 07/08：fold seed=0、paper_protocol、paper_channel、带标签 calibration 的阈值与车辆 Top-p。",
  "_source": "Zhang et al., Realistic fault detection of Li-ion battery via dynamical deep learning, Nature Communications 2023",
  "common_env": {
    "PYTHONIOENCODING": "utf-8",
    "MPLCONFIGDIR": "/tmp/matplotlib"
  },
  "common_args": {
    "batch_size": 128,
    "num_workers": 4,
    "vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "dyad",
      "baseline": "DyAD",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "dyad", "epochs": 0}
    },
    {
      "name": "gdn",
      "baseline": "GDN-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "gdn", "epochs": 20}
    },
    {
      "name": "auto_encoder",
      "baseline": "AE-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "auto_encoder", "epochs": 20}
    },
    {
      "name": "deep_svdd",
      "baseline": "Deep-SVDD-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "deepsvdd", "epochs": 10, "batch_size": 64}
    },
    {
      "name": "lstm_ad",
      "baseline": "LSTM-AD-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "lstm_ad", "epochs": 20}
    },
    {
      "name": "isolation_forest",
      "baseline": "IsolationForest-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "matrix": {"battery_brand": [1, 2, 3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "method": "isolation_forest",
        "isolation_train_samples": 0,
        "isolation_trees": 200
      }
    }
  ]
}

{
  "plan_name": "02_ch4_nasa_random_external",
  "_comment": "第四章 NASA_RANDOM_DISCHARGE 外部基线计划。围绕 RW1、RW2、RW7、RW8 四个随机工况序列，保留 TranAD、GDN、DCdetector 三类代表性基线，兼顾可比性与重跑成本。",
  "_usage": "建议先 dry-run 检查命令：python -m src.runners.run_external_baselines --plan configs/external/02_ch4_nasa_random_external.json --dry-run",
  "_ready_now": [
    "TranAD、GDN、DCdetector 已支持直接读取主仓 NASA_RANDOM_DISCHARGE processed 数据。",
    "随机工况序列命名按 NASA_RANDOM_DISCHARGE_RW* 直接对齐。"
  ],
  "_pending_now": [
    "Anomaly-Transformer 与 GANF 默认移出精简计划，必要时再作为补充实验单独追加。"
  ],
  "_thesis_scope_note": "本计划只服务于第四章随机工况电池外部基线对比，目标是支撑论文主表，而不是继续扩展模型数量。",
  "common_env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "experiments": [
    {
      "name": "tranad_nasa_random_rw1_ch4",
      "baseline": "TranAD",
      "script": "main.py",
      "args": {
        "dataset": "NASA_RANDOM_DISCHARGE_RW1",
        "model": "TranAD"
      },
      "flags": [
        "retrain"
      ],
      "skip_if_exists": "checkpoints/TranAD_NASA_RANDOM_DISCHARGE_RW1/model.ckpt"
    },
    {
      "name": "gdn_nasa_random_rw1_ch4",
      "baseline": "GDN",
      "script": "main.py",
      "args": {
        "-dataset": "NASA_RANDOM_DISCHARGE_RW1",
        "-device": "cuda",
        "-epoch": 10,
        "-batch": 128,
        "-slide_win": 15,
        "-slide_stride": 5,
        "-save_path_pattern": "ch4_gdn_nasa_random_rw1"
      },
      "skip_if_exists": "pretrained/ch4_gdn_nasa_random_rw1"
    },
    {
      "name": "dcdetector_nasa_random_rw1_ch4",
      "baseline": "DCdetector",
      "script": "main.py",
      "args": {
        "dataset": "NASA_RANDOM_DISCHARGE_RW1",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch4_dcdetector_nasa_random_rw1",
        "input_c": 4,
        "output_c": 4,
        "num_epochs": 10,
        "batch_size": 128,
        "win_size": 100,
        "patch_size": "[5]",
        "anormly_ratio": 4.0,
        "lr": 1e-4
      },
      "skip_if_exists": "checkpoints/ch4_dcdetector_nasa_random_rw1/NASA_RANDOM_DISCHARGE_RW1_checkpoint.pth"
    },

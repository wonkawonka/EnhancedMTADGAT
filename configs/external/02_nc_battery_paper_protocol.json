{
  "plan_name": "02_nc_battery_paper_protocol",
  "_lifecycle": "archived_brand3_replaced_by_unified_07_08",
  "_thesis_role": "历史协议复核；Brand3 已移至统一 runner 的 07/08。",
  "_protocol": "每折以其余四组正常车训练，以这些正常车和一组故障车校准阈值，以留出正常车和其余故障车测试。本计划仅保留 Brand1/2；Brand3 必须使用 07/08 的统一 paper_channel 数据契约。",
  "_source": "Zhang et al., Nature Communications 2023, Supplementary Note 2, Five fold evaluation",
  "common_env": {
    "PYTHONIOENCODING": "utf-8",
    "MPLCONFIGDIR": "/tmp/matplotlib"
  },
  "common_args": {
    "batch_size": 128,
    "num_workers": 4,
    "vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "dyad_paper_protocol",
      "baseline": "DyAD",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "dyad", "epochs": 0}
    },
    {
      "name": "gdn_paper_protocol",
      "baseline": "GDN-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "gdn", "epochs": 20}
    },
    {
      "name": "auto_encoder_paper_protocol",
      "baseline": "AE-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "auto_encoder", "epochs": 20}
    },
    {
      "name": "deep_svdd_paper_protocol",
      "baseline": "Deep-SVDD-Battery",
      "cwd": ".",
      "module": "src.runners.train_nc_external",
      "flags": ["require_cuda"],
      "matrix": {"battery_brand": [1, 2], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {"method": "deepsvdd", "epochs": 10, "batch_size": 64}
    }
  ]
}

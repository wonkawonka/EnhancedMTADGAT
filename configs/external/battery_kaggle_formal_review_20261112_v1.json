  "training_policies": {
    "rcr": {
      "epochs": 30,
      "early_stopping_patience": 8,
      "selection": "strict_minimum_full_normal_validation_Huber_delta1; earliest on tie",
      "scheduler": "none",
      "loss": "Huber delta=1, mean over batch/time/variables"
    },
    "mtad": {
      "epochs": 30,
      "early_stopping_patience": null,
      "selection": "strict_minimum_full_normal_validation_forecast_RMSE_plus_reconstruction_RMSE; earliest on tie",
      "scheduler": "none",
      "loss": "sqrt(batch_forecast_MSE)+sqrt(batch_reconstruction_MSE)"
    },
    "tranad": {
      "epochs": 5,
      "early_stopping_patience": null,
      "selection": "final epoch5, not best test or first-stage validation loss",
      "scheduler": "StepLR(step_size=5,gamma=0.9), step after each completed epoch",
      "loss": "epoch n=1..5: MSE(first,last_input)/n + (1-1/n)*MSE(second,last_input)"
    },
    "at": {
      "epochs": 10,
      "early_stopping_patience": 3,
      "selection": "author dual validation comparator on NORMAL validation: save when neither objective is worse than its saved value, delta0; equal qualifies per author code",
      "scheduler": "after epoch n=1..10 set lr=base_lr*0.5**(n-1)",
      "loss": "backprop(rec-3*series_KL) and (rec+3*prior_KL); preserve both reconstruction gradients and detached branches"

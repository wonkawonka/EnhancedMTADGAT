{
  "plan_name": "01_ch3_msl_external",
  "_comment": "第三章外部基线计划：只保留 MSL 上最常见、最能支撑论文主表的四类对比模型。",
  "_usage": "建议先 dry-run 检查命令：python -m src.runners.run_external_baselines --plan configs/external/01_ch3_msl_external.json --dry-run",
  "_thesis_role": "第三章外部基线对比",
  "common_env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "experiments": [
    {
      "name": "tranad_msl_ch3",
      "baseline": "TranAD",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "model": "TranAD"
      },
      "flags": [
        "retrain"
      ],
      "skip_if_exists": "checkpoints/TranAD_MSL/model.ckpt"
    },
    {
      "name": "anomaly_transformer_msl_ch3",
      "baseline": "Anomaly-Transformer",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_msl",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 256,
        "win_size": 100,
        "anormly_ratio": 4.0
      },
      "skip_if_exists": "checkpoints/ch3_msl/MSL_checkpoint.pth"
    },
    {
      "name": "gdn_msl_ch3",
      "baseline": "GDN",
      "script": "main.py",
      "args": {
        "-dataset": "msl",
        "-device": "cuda",
        "-epoch": 10,
        "-batch": 128,
        "-slide_win": 15,
        "-slide_stride": 5,
        "-save_path_pattern": "ch3_gdn_msl"
      },
      "skip_if_exists": "pretrained/ch3_gdn_msl"
    },
    {
      "name": "dcdetector_msl_ch3",
      "baseline": "DCdetector",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_dcdetector_msl",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 128,
        "win_size": 100,
        "patch_size": "[5]",
        "anormly_ratio": 4.0,
        "lr": 1e-4
      },
      "skip_if_exists": "checkpoints/ch3_dcdetector_msl/MSL_checkpoint.pth"
    }
  ]
}

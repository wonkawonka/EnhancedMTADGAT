{
  "plan_name": "research_12_dyad_style_ch_p1",
  "lifecycle": "adapter_ready__blocked_by_cuda_visibility",
  "not_for_final_matrix": true,
  "purpose": "在 CH-BatteryGen 域内基线中补充 DyAD-style DynamicVAE；它不是 NC Battery 原始 DyAD 结果。",
  "model": {
    "name": "DyAD-style CH",
    "backbone": "bidirectional GRU DynamicVAE",
    "input_features": ["SUM_VOLTAGE", "SUM_CURRENT", "SOC", "MAX_CELL_VOLT", "MIN_CELL_VOLT", "MAX_TEMP", "MIN_TEMP"],
    "condition_features": ["SUM_CURRENT", "SOC"],
    "response_features": ["SUM_VOLTAGE", "MAX_CELL_VOLT", "MIN_CELL_VOLT", "MAX_TEMP", "MIN_TEMP"],
    "excluded_nc_component": "mileage auxiliary prediction",
    "report_label": "DyAD-style CH adaptation"
  },
  "protocol": {
    "split_seed": 3407,
    "model_seeds": [3407, 3408, 3409],
    "train": "normal VINs only",
    "scaler": "fit on source train-normal VINs only",
    "lookback": 32,
    "stride": 4,
    "aggregation": ["max", "mean", "top5pct"],
    "thresholds": ["train-normal P95", "train-normal P99", "validation-normal P95", "validation-normal P99"]
  },
  "cells": [
    {"dataset": "CH_LFP_DISCHARGE", "formal_root": "datasets/CH-BatteryGen/formal_lfp"},
    {"dataset": "CH_NCM_DISCHARGE", "formal_root": "datasets/CH-BatteryGen/formal_first_round/ncm_discharge_to_discharge"}
  ],
  "outputs": ["metrics.json", "runtime.json", "scores.npz", "train_scores.npz", "validation_scores.npz", "ch_battery_sample_scores.csv", "aggregation_threshold_sensitivity.csv"],
  "next": "Run one GPU smoke cell, then run all six P1 cells serially on the fixed split."
}

{
  "plan_name": "research_01_ch_batterygen_lfp_mtadgat_baseline",
  "_role": "问题发现预实验 Phase 1：CH-BatteryGen LFP 放电片段的 VIN 隔离 normal-only MTAD-GAT 基线。",
  "_protocol": "训练只使用正常 VIN；正常 VIN 按 80/20 划分训练和留出测试；故障 VIN 仅参与测试。所有阈值和缩放统计均来自训练正常数据。样本级分数为 top 5% 窗口分数均值，连续分数的 AUROC/AUPRC 为主指标。",
  "_not_for_final_matrix": true,
  "common_env": {
    "PYTHONIOENCODING": "utf-8",
    "MPLCONFIGDIR": "/tmp/matplotlib"

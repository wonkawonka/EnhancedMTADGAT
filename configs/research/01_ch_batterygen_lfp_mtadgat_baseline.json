    "ch_battery_train_ratio": 0.8,
    "ch_battery_sample_score": "score_topk_mean",
    "ch_battery_topk_ratio": 0.05,
    "model_name": "mtad_gat",
    "epochs": 15,
    "bs": 96,
    "lookback": 8,

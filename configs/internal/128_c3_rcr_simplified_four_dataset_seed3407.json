{
  "plan_name": "128_c3_rcr_simplified_four_dataset_seed3407",
  "_lifecycle": "development_cross_dataset_structure_validation",
  "_purpose": "验证精简 C3-RCR：去掉 prototype-query 和描述辅助损失，保留低维 restricted 状态 FiLM，并加入只由正常数据拟合的 RCR 线性条件残差均值/尺度校准。",
  "_protocol": "MSL/SMAP 使用 all-to-target0、30 epoch、无早停、best-validation；Brand3 使用 paper_protocol 五折、response scoring。测试标签不参与训练、校准、checkpoint 或阈值选择。CH 混合循环由独立队列补充，因为其样本级协议不经过 compare_experiments 的车辆 runner。",
  "_evidence_basis": {
    "keep": [
      "restricted marginal-state descriptors",
      "bounded fusion-level FiLM",
      "RCR normal-only linear conditional residual calibration"
    ],
    "remove": [
      "prototype-query cross attention",
      "prototype routing",
      "descriptor auxiliary loss"
    ],
    "reason": "RCR CH/Brand3 evidence supports conditional calibration; Graph has no stable gain. C3 task125 shows No-Aux close to baseline and shuffled state can match/exceed Full on individual metrics, so the complex state encoder is not yet independently justified."
  },
  "seeds": [3407],
  "common_args": {
    "model_name": "mtad_gat",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "forecast_loss": "mse",
    "recon_loss": "mse",
    "use_transformer": false,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "use_revin": false,
    "use_learnable_sparse_graph": false,
    "regime_encoder_type": "restricted",
    "regime_emb_dim": 8,
    "regime_condition_mode": "fusion",
    "regime_film_scale": 0.1,
    "regime_prototype_lambda": 0.0,
    "use_regime_condition": true,
    "regime_aux_lambda": 0.0,
    "regime_condition_shuffle": false,
    "score_fusion_mode": "fixed",
    "use_c3_joint_relation": false,
    "use_relation_change_score": false,
    "use_physical_graph_bias": false,
    "use_physical_consistency_head": false,
    "use_cuda": true,
    "require_cuda": true,
    "deterministic": true,
    "num_workers": 2,
    "predict_num_workers": 0,
    "persistent_workers": true,
    "epochs": 30,
    "early_stopping_patience": 0,
    "early_stopping_min_delta": 0.0001,
    "checkpoint_selection": "best_validation",
    "log_tensorboard": false
  },
  "experiments": [
    {
      "name": "c3_rcr_simplified_msl",
      "args": {
        "dataset": "MSL",
        "bs": 128,
        "lookback": 100,
        "window_stride": 1,
        "val_split": 0.1,
        "nasa_validation_protocol": "temporal_per_entity",
        "nasa_score_calibration": "none",
        "nasa_feature_scope": "target0",
        "use_rcr_residual_calibration": true,
        "run_id": "dev128_c3_rcr_simplified_msl"
      }
    },
    {
      "name": "c3_rcr_simplified_smap",
      "args": {
        "dataset": "SMAP",
        "bs": 128,
        "lookback": 100,
        "window_stride": 1,
        "val_split": 0.1,
        "nasa_validation_protocol": "temporal_per_entity",
        "nasa_score_calibration": "none",
        "nasa_feature_scope": "target0",
        "use_rcr_residual_calibration": true,
        "run_id": "dev128_c3_rcr_simplified_smap"
      }
    },
    {
      "name": "c3_rcr_simplified_brand3",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "battery_brand": 3,
        "battery_fold_seed": 0,
        "battery_split_protocol": "paper_protocol",
        "battery_normalization": "paper_channel",
        "battery_windows_per_snippet": 1,
        "battery_vehicle_top_ratio": 0.05,
        "battery_vehicle_top_ratio_mode": "labelled_calibration",
        "battery_score_channels": "response",
        "bs": 64,
        "lookback": 127,
        "use_condition_residual_calibration": true,
        "condition_calibration_method": "linear_rcr",
        "run_id": "dev128_c3_rcr_simplified_brand3"
      }
    }
  ]
}

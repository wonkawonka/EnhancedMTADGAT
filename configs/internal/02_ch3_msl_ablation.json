{
  "plan_name": "02_ch3_msl_ablation",
  "_comment": "第三章消融计划：只在 MSL 上完成关键模块消融，保证消融结论集中、篇幅可控且便于答辩展开。",
  "_usage": "建议在 01_ch3_msl_main.json 跑通后执行；如果预算有限，可优先运行 no_regime 与 no_transformer。",
  "_thesis_role": "第三章模块消融",
  "_experiment_mapping": [
    "msl_no_transformer：验证 Transformer 残差增强的贡献。",
    "msl_no_regime：验证状态感知调制的贡献。",
    "msl_no_revin：验证 RevIN 的贡献。",
    "msl_fixed_fusion：验证质量感知融合的贡献。",
    "msl_no_event：验证事件一致性约束的贡献。"
  ],
  "common_args": {
    "dataset": "MSL",
    "model_name": "mtad_gat_c3",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "use_transformer": true,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "use_revin": true,
    "use_regime_condition": true,
    "regime_emb_dim": 32,
    "regime_condition_mode": "transformer_residual",
    "regime_stat_features": "mean,std,last,delta",
    "score_fusion_mode": "quality_aware",
    "use_event_consistency": true,
    "event_low_ratio": 0.5,
    "event_min_length": 3,
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "msl_no_transformer",
      "comment": "关闭 Transformer 残差分支，并将状态注入方式切回 fusion。",
      "args": {
        "model_name": "mtad_gat",
        "use_transformer": false,
        "regime_condition_mode": "fusion",
        "run_id": "ch3abl_msl_no_transformer"
      }
    },
    {
      "name": "msl_no_regime",
      "comment": "关闭状态感知调制。",
      "args": {
        "model_name": "mtad_gat",
        "use_regime_condition": false,
        "run_id": "ch3abl_msl_no_regime"
      }
    },
    {
      "name": "msl_no_revin",
      "comment": "关闭 RevIN。",
      "args": {
        "use_revin": false,
        "run_id": "ch3abl_msl_no_revin"
      }
    },
    {
      "name": "msl_fixed_fusion",
      "comment": "将 quality-aware 融合退回 fixed。",
      "args": {
        "score_fusion_mode": "fixed",
        "run_id": "ch3abl_msl_fixed_fusion"
      }
    },
    {
      "name": "msl_no_event",
      "comment": "关闭事件一致性。",
      "args": {
        "use_event_consistency": false,
        "run_id": "ch3abl_msl_no_event"
      }
    }
  ]
}

{
  "plan_name": "06_kaggle_formal",
  "_thesis_role": "正式主实验：完整三品牌数据，品牌独立建模，车辆级五折评估",
  "_protocol": "主结果使用strict_normal_validation：正常车辆划分训练/验证/测试，故障车辆只进入测试；片段窗口误差先聚合为片段分数，再取每辆车top-5%片段均值；主报vehicle AUROC/AUPRC和TPR@FPR。",
  "_runtime_note": "论文DyAD在完整数据上仅训练3-5轮；内部模型预留10轮并用3轮早停，不削减车辆或片段。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "strict_normal_validation",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "physical_alg_lambda": 0.1,
    "physical_smooth_lambda": 0.005,
    "physical_response_max_weight": 0.35,
    "score_fusion_mode": "quality_aware",
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_mtadgat_all",
      "runner": "src.runners.train_nc_battery",
      "comment": "忠实MTAD-GAT：训练和计分均覆盖全部通道。",
      "matrix": {"battery_brand": [1, 2, 3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat",
        "battery_score_channels": "all",
        "score_fusion_mode": "fixed",
        "regime_aux_lambda": 0.0,
        "run_id": "kformal_battery_mtadgat_all"
      }
    },
    {
      "name": "battery_c3",
      "runner": "src.runners.train_nc_battery",
      "comment": "第三章主模型：电流/SOC工况编码及融合表示FiLM条件化。",
      "matrix": {"battery_brand": [1, 2, 3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3_regime",
        "battery_score_channels": "response",
        "run_id": "kformal_battery_c3"
      }
    },
    {
      "name": "battery_c4",
      "runner": "src.runners.train_nc_battery",
      "comment": "第四章主模型：C3加物理状态、响应一致性损失及物理响应计分。",
      "matrix": {"battery_brand": [1, 2, 3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "run_id": "kformal_battery_c4"
      }
    },
    {
      "name": "battery_c3_no_condition",
      "runner": "src.runners.train_nc_battery",
      "comment": "核心消融仅在brand3完整五折：去掉工况条件化。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3_regime",
        "battery_score_channels": "response",
        "use_regime_condition": false,
        "regime_aux_lambda": 0.0,
        "run_id": "kformal_battery_c3_no_condition"
      }
    },
    {
      "name": "battery_c3_no_aux",
      "runner": "src.runners.train_nc_battery",
      "comment": "核心消融仅在brand3完整五折：去掉状态辅助任务。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3_regime",
        "battery_score_channels": "response",
        "regime_aux_lambda": 0.0,
        "run_id": "kformal_battery_c3_no_aux"
      }
    },
    {
      "name": "battery_c4_state_only",
      "runner": "src.runners.train_nc_battery",
      "comment": "核心消融仅在brand3完整五折：保留物理状态编码，去掉物理损失与计分。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "use_physical_regularization": false,
        "use_physical_response_score": false,
        "run_id": "kformal_battery_c4_state_only"
      }
    }
  ]
}

{
  "plan_name": "19_c3_remaining_condition_location_diagnostic",
  "_thesis_role": "计划18续跑：仅运行尚未完成的Temporal-GAT与Transformer残差门控C3。",
  "_protocol": "沿用计划14论文协议与统一归一化；七通道联合训练、五响应通道主计分。",
  "_selection_rule": "仅当AUROC与AP均超过同折MTAD-GAT时，才进入C4及五折验证。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_physical_response_features": false,
    "use_control_response_decoder": false,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407,
    "dataset": "TSINGHUA_EV",
    "model_name": "mtad_gat_c3",
    "battery_brand": 3,
    "battery_fold": 0
  },
  "experiments": [
    {
      "name": "battery_c3_temporal_gat_condition_f0",
      "runner": "src.runners.train_nc_battery",
      "args": {
        "regime_condition_mode": "temporal_gat",
        "run_id": "c3_temporal_gat_condition_f0"
      }
    },
    {
      "name": "battery_c3_transformer_residual_condition_f0",
      "runner": "src.runners.train_nc_battery",
      "args": {
        "regime_condition_mode": "transformer_residual",
        "run_id": "c3_transformer_residual_condition_f0"
      }
    }
  ]

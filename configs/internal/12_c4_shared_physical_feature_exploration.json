{
  "plan_name": "12_c4_shared_physical_feature_exploration",
  "_thesis_role": "第四章开发探索，不进入正式主结果。保持 C3 主干，比较三种响应物理特征的网络内融合方式。",
  "_protocol": "只运行 brand3/fold0。三个方案均从与 06_kaggle_formal/battery_c3_b3_f0 相同的共享参数初始化出发，只改变物理特征插入方式；关闭旧物理状态、物理正则和物理计分。物理特征先按训练折缩放参数恢复原始量纲，再构造电压/温度变化率、极差、累计电荷和 SOC-电流一致性。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "strict_normal_validation",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_physical_response_features": true,
    "physical_feature_hidden_dim": 32,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_c4_physics_shared_residual",
      "runner": "src.runners.train_nc_battery",
      "comment": "方案 A：物理特征经零初始化门控残差加入 C3 共享融合表示，同时进入 GRU 和 Transformer。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "physical_feature_fusion_mode": "shared_residual",
        "run_id": "c4physical_battery_shared_residual"
      }
    },
    {
      "name": "battery_c4_physics_shared_film",
      "runner": "src.runners.train_nc_battery",
      "comment": "方案 B：物理特征生成逐时刻 FiLM 参数，调节 C3 共享融合表示。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "physical_feature_fusion_mode": "shared_film",
        "run_id": "c4physical_battery_shared_film"
      }
    },
    {
      "name": "battery_c4_physics_feature_gat_residual",
      "runner": "src.runners.train_nc_battery",
      "comment": "方案 C：物理特征经零初始化门控残差加入 Feature-GAT 输出，再进入原 C3 共享主干。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "physical_feature_fusion_mode": "feature_gat_residual",
        "run_id": "c4physical_battery_feature_gat_residual"
      }
    }
  ]
}

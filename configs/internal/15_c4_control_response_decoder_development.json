{
  "plan_name": "15_c4_control_response_decoder_development",
  "_thesis_role": "第四章 brand3 五折开发：不再注入响应统计量，改为仅由电流/SOC历史条件化响应解码器。",
  "_protocol": "与计划14完全相同：Zhang et al. seed=0车辆折、论文通道归一化、带标签校准折选择片段阈值与Top-p。既有C3、MTAD-GAT和DyAD结果复用计划14/03，不重跑。",
  "_metric": "主指标 AUROC 和 PR-AUC=Average Precision。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": true,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_physical_response_features": false,
    "use_control_response_decoder": true,
    "control_response_hidden_dim": 32,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_c4_control_response_decoder",
      "runner": "src.runners.train_nc_battery",
      "comment": "C4-R1：电流/SOC及其变化率通过因果GRU生成响应预测和重构校正；无控制—响应辅助约束。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "control_response_aux_weight": 0.0,
        "run_id": "c4_control_response_decoder"
      }
    },
    {
      "name": "battery_c4_control_response_decoder_aux",
      "runner": "src.runners.train_nc_battery",
      "comment": "C4-R2：R1加控制量独立预测响应的辅助损失，不参与最终异常分数。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "regime_aux_lambda": 0.1,
        "control_response_aux_weight": 0.5,
        "run_id": "c4_control_response_decoder_aux"
      }
    }
  ]
}

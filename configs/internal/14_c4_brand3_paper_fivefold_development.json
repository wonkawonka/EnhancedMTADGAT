{
  "plan_name": "14_c4_brand3_paper_fivefold_development",
  "_thesis_role": "第四章小规模本机开发验证：仅 brand3 五折，不扩展到其他品牌。",
  "_protocol": "复现 Zhang et al. 公开五折角色与 seed=0 车辆划分；带标签校准折选择片段阈值和车辆 Top-p，测试折只评估。所有模型统一使用 DyAD 前200训练片段逐通道归一化。",
  "_metric": "主指标 AUROC 与 PR-AUC=Average Precision；梯形 PR 曲线面积仅作附加字段。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "physical_feature_hidden_dim": 32,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_mtad_gat_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "忠实MTAD-GAT训练全部七通道；主报响应通道，并同时保存all-channel计分。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat",
        "battery_response_only_training": false,
        "battery_score_channels": "response",
        "run_id": "mtad_gat_paper_norm"
      }
    },
    {
      "name": "battery_c3_response_targets_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "C3使用全部输入，训练输出和损失仅覆盖五个响应通道。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3",
        "battery_response_only_training": true,
        "battery_score_channels": "response",
        "use_physical_response_features": false,
        "run_id": "c3_response_targets_paper_norm"
      }
    },
    {
      "name": "battery_c4_shared_film_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "响应目标加共享FiLM物理特征。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_response_only_training": true,
        "battery_score_channels": "response",
        "use_physical_response_features": true,
        "physical_feature_fusion_mode": "shared_film",
        "run_id": "c4_shared_film_paper_norm"
      }
    },
    {
      "name": "battery_c4_physical_gat_bias_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "响应目标加物理条件化Feature-GAT边权偏置。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_response_only_training": true,
        "battery_score_channels": "response",
        "use_physical_response_features": true,
        "physical_feature_fusion_mode": "feature_gat_attention_bias",
        "run_id": "c4_physical_gat_bias_paper_norm"
      }
    }
  ]
}

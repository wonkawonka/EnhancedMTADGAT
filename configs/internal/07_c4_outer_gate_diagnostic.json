{
  "plan_name": "07_c4_outer_gate_diagnostic",
  "_thesis_role": "开发诊断，不进入正式主结果或消融表。用于检验以工况门控的 Transformer 外层残差，是否能缓解 C4 物理状态直接注入 Transformer 输入造成的表征干扰。",
  "_protocol": "只运行 brand3/fold0 的配对 C3 与 C4-state-only；两者除物理状态编码外完全一致。fold0 已用于开发诊断，后续不得把该折纳入锁定结构后的最终 C4 汇总。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "strict_normal_validation",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "transformer_residual",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_c3_outer_gate",
      "runner": "src.runners.train_nc_battery",
      "comment": "外层门控 C3 参照：h_end = h_gru + gate(regime) * h_transformer。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3_regime",
        "battery_score_channels": "response",
        "run_id": "c4diag_battery_c3_outer_gate"
      }
    },
    {
      "name": "battery_c4_outer_gate_state_only",
      "runner": "src.runners.train_nc_battery",
      "comment": "仅相对外层门控 C3 增加物理状态编码；关闭物理损失与物理响应计分。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "use_physical_regularization": false,
        "use_physical_response_score": false,
        "run_id": "c4diag_battery_c4_outer_gate_state_only"
      }
    }
  ]
}

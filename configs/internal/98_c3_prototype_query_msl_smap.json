{
  "plan_name": "98_c3_prototype_query_msl_smap",
  "_lifecycle": "archived_development_pre_99",
  "_archive_note": "98号为99号正式实验前的单 seed 开发结果；正式 MSL/SMAP 结果使用100号三 seed 计划。",

  "common_args": {
    "epochs": 30,
    "bs": 128,
    "lookback": 100,
    "window_stride": 1,
    "val_split": 0.1,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,

    "model_name": "mtad_gat",

    "use_transformer": false,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "use_revin": false,
    "use_learnable_sparse_graph": false,

    "regime_emb_dim": 8,
    "regime_query_dim": 32,
    "regime_num_prototypes": 6,
    "regime_query_heads": 4,
   
    "regime_condition_mode": "fusion",
    "regime_film_scale": 0.1,
    "regime_prototype_lambda": 0.0,

    "use_c3_joint_relation": false,
    "score_fusion_mode": "fixed",
    "use_relation_change_score": false,
    "use_condition_residual_calibration": false,

    "use_physical_consistency_head": false,
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_control_response_decoder": false,

    "use_cuda": true,
    "require_cuda": true,
    "deterministic": true,
    "num_workers": 2,
    "predict_num_workers": 0,
    "persistent_workers": true,

    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },

  "experiments": [
    {
      "name": "baseline",
      "matrix": {
        "dataset": ["MSL", "SMAP"]
      },
      "args": {
        "use_regime_condition": false,
        "regime_aux_lambda": 0.0,
        "run_id": "c3pq_public_baseline"
      }
    },
    {
        "name": "restricted",
        "matrix": {
        "dataset": ["MSL", "SMAP"]
        },
        "args": {
        "regime_encoder_type": "restricted",
        "use_regime_condition": true,
        "regime_condition_shuffle": false,
        "regime_aux_lambda": 0.05,
        "regime_film_scale": 0.1,
        "regime_prototype_lambda": 0.0,
        "run_id": "c3_public_restricted"
        }
    },
    {
        "name": "prototype_query",
        "matrix": {
            "dataset": ["MSL", "SMAP"]
        },
        "args": {
            "regime_encoder_type": "prototype_query",
            "use_regime_condition": true,
            "regime_condition_shuffle": false,
            "regime_aux_lambda": 0.05,
            "regime_film_scale": 0.1,
            "regime_prototype_lambda": 0.0,
            "run_id": "c3pq_public"
        }
    }
  ]
}

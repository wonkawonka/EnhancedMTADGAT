{
  "plan_name": "05_condition_validation",
  "_thesis_role": "动态状态表征有效性与真实BMS案例，不参与故障检测主表",
  "_comment": "NASA Random Walk不是已删除的经典NASA数据；其原始工步码不进入模型，仅按电流方向做事后弱表征探针与跨电池稳定性检查。BMS测试段确认全程正常，仅比较状态条件化前后的经验误报率和跨簇/跨时段稳定性。",
  "common_args": {
    "model_name": "mtad_gat_c3_regime",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "val_split": 0.0,
    "use_transformer": true,
    "use_revin": false,
    "use_regime_condition": true,
    "regime_encoder_type": "temporal",
    "regime_aux_lambda": 0.05,
    "regime_condition_mode": "fusion",
    "use_event_consistency": false,
    "normalize": true,
    "use_cuda": true,
    "require_cuda": true,
    "early_stopping_patience": 0,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "nasa_random_condition",
      "args": {
        "dataset": "NASA_RANDOM_DISCHARGE",
        "nasa_train_batteries": "RW1,RW2,RW7",
        "nasa_test_batteries": "RW8",
        "window_stride": 4,
        "run_id": "condition_nasa_lobo_rw8"
      }
    },
    {
      "name": "bms_frequency_regulation_unconditioned",
      "args": {
        "dataset": "BMS",
        "window_stride": 4,
        "use_regime_condition": false,
        "regime_aux_lambda": 0.0,
        "run_id": "condition_bms_unconditioned"
      }
    },
    {
      "name": "bms_frequency_regulation_conditioned",
      "args": {
        "dataset": "BMS",
        "window_stride": 4,
        "run_id": "condition_bms_conditioned"
      }
    }
  ]
}

{
  "plan_name": "94_c4_response_aware_unidirectional_brand3_paper_fivefold",
  "_thesis_role": "恢复旧 C4 的完整窗口状态编码，仅将双向状态 GRU 改为单向 GRU。",
  "_protocol": "Brand3 论文协议五折；融合权重继续只由正常训练集数值稳定性确定，不新增带标签权重搜索。",
  "_metric": "车辆级 AP 为主指标，AUROC 与低误报 TPR 为辅助指标；带标签 calibration 选择车辆 Top-p。",
  "common_args": {
    "dataset": "TSINGHUA_EV", "battery_brand": 3, "battery_fold_seed": 0,
    "battery_split_protocol": "paper_protocol", "battery_normalization": "paper_channel",
    "battery_windows_per_snippet": 1, "battery_vehicle_top_ratio": 0.05,
    "battery_vehicle_top_ratio_mode": "labelled_calibration", "battery_response_only_training": false,
    "battery_score_channels": "response", "epochs": 10, "bs": 128, "lookback": 127,
    "normalize": true, "init_lr": 0.001, "dropout": 0.3, "model_name": "mtad_gat",
    "score_fusion_mode": "quality_aware", "use_regime_condition": false,
    "regime_aux_lambda": 1.0, "use_c3_joint_relation": false,
    "use_relation_change_score": false, "use_condition_residual_calibration": false,
    "use_physical_consistency_head": true,
    "physical_consistency_encoder_input": "full_window",
    "physical_consistency_encoder_bidirectional": false,
    "physical_consistency_hidden_dim": 64, "physical_consistency_latent_dim": 16,
    "physical_consistency_aux_weight": 1.0, "physical_consistency_kl_weight": 0.0001,
    "physical_consistency_score_max_weight": 0.35,
    "use_cuda": true, "require_cuda": true, "deterministic": true,
    "num_workers": 4, "predict_num_workers": 4, "persistent_workers": true,
    "early_stopping_patience": 3, "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false, "seed": 3407
  },
  "experiments": [
    {
      "name": "baseline", "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "use_physical_consistency_head": false,
        "physical_consistency_aux_weight": 0.0,
        "run_id": "c4_response_aware_unidir_baseline"
      }
    },
    {
      "name": "response_aware_unidir", "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {"run_id": "c4_response_aware_unidir"}
    }
  ]
}

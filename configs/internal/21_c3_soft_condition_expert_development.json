{
  "plan_name": "21_c3_soft_condition_expert_development",
  "_thesis_role": "C3开发验证：仅由电流/SOC轨迹形成连续工况状态，在正常窗口上学习MTAD-GAT预测与重构残差的条件分布；不向主干注入响应特征。",
  "_protocol": "Brand3 fold0小规模开发；论文式逐通道归一化及独立带标签校准折选择Top-p。条件专家仅用normal validation拟合，测试故障标签不参与拟合或融合。",
  "_metric": "主指标PR-AUC（Average Precision），同步报告AUROC；同一次主干推理内输出response_channels基线与condition_calibrated_response，进行严格配对比较。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_transformer": false,
    "use_regime_condition": false,
    "use_revin": false,
    "score_fusion_mode": "quality_aware",
    "use_condition_residual_calibration": true,
    "condition_calibration_method": "soft_expert",
    "condition_calibration_clusters": 8,
    "condition_calibration_temperature": 1.0,
    "use_physical_consistency_head": false,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407,
    "dataset": "TSINGHUA_EV",
    "model_name": "mtad_gat",
    "battery_brand": 3,
    "battery_fold": 0
  },
  "experiments": [
    {
      "name": "battery_c3_soft_condition_expert_f0",
      "runner": "src.runners.train_nc_battery",
      "comment": "连续软工况专家：由控制量轨迹混合多个正常残差密度专家。",
      "args": {
        "regime_aux_lambda": 0.0,
        "run_id": "c3_soft_condition_expert_f0"
      }
    }
  ]
}

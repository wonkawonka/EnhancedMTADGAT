{
  "plan_name": "103_c3_core_ablation_msl_smap_brand3_fivefold_three_seed",
  "_lifecycle": "formal_post_99_ablation",
  "_thesis_role": "正式 C3 核心消融：MSL/SMAP 与 Brand3 五折验证正确工况配对和统计描述辅助损失，不改变冻结主干架构。",
  "_protocol": "MSL/SMAP 使用官方独立序列；Brand3 使用 paper_protocol 的完整五折；所有实验从头训练，测试标签只用于最终评价。该计划属于正式实验，不再使用单一 Brand3 fold1 开发折。",
  "_epoch_protocol": "同一数据集内所有消融臂使用相同 epoch 预算：MSL/SMAP 与 Brand3 均最大 30 epochs；MSL/SMAP patience=3，Brand3 patience=0 以保持车辆五折固定预算。",
  "_shuffle_protocol": "shuffled_state 使用 batch 内统计描述的最远无自配对，保持条件边际分布；不使用 legacy cyclic roll(1)。",
  "_runtime_protocol": "正式消融同样记录预处理时间、参数量、训练时间、推理吞吐、P50/P95 批延迟和峰值显存。",
  "seeds": [3407, 3408, 3409],
  "common_args": {
    "model_name": "mtad_gat",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_transformer": false,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "use_revin": false,
    "use_learnable_sparse_graph": false,
    "regime_emb_dim": 8,
    "regime_query_dim": 32,
    "regime_num_prototypes": 6,
    "regime_query_heads": 4,
    "regime_temperature": 0.5,
    "regime_condition_mode": "fusion",
    "regime_film_scale": 0.1,
    "regime_prototype_lambda": 0.0,
    "regime_condition_shuffle_mode": "farthest",
    "score_fusion_mode": "fixed",
    "use_c3_joint_relation": false,
    "use_relation_change_score": false,
    "use_condition_residual_calibration": false,
    "use_physical_consistency_head": false,
    "use_cuda": true,
    "require_cuda": true,
    "deterministic": true,
    "predict_num_workers": 0,
    "log_tensorboard": false
  },

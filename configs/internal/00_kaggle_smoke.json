{
  "plan_name": "00_kaggle_smoke",
  "_purpose": "只检查官方完整数据的索引、车辆级划分、训练、推理和结果打包链路；不作为论文结果。",
  "common_args": {
    "dataset": "TSINGHUA_EV",
    "epochs": 1,
    "bs": 64,
    "lookback": 32,
    "battery_brand": 3,
    "battery_fold": 0,
    "battery_split_protocol": "strict_normal_validation",
    "battery_windows_per_snippet": 1,
    "battery_max_snippets_per_vehicle": 5,
    "battery_vehicle_top_ratio": 0.05,
    "normalize": true,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 2,
    "persistent_workers": false,
    "early_stopping_patience": 0,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_brand3_mtadgat_smoke",
      "runner": "src.runners.train_nc_battery",
      "args": {
        "model_name": "mtad_gat",
        "battery_score_channels": "all",
        "score_fusion_mode": "fixed",
        "run_id": "smoke_battery_brand3_mtadgat"
      }
    },
    {
      "name": "battery_brand3_c4_smoke",
      "runner": "src.runners.train_nc_battery",
      "args": {
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "run_id": "smoke_battery_brand3_c4"
      }
    }
  ]
}

{
  "plan_name": "01_ch3_msl_main",
  "_comment": "第三章主结果计划：只保留 MSL 作为公开标准数据集，聚焦 baseline 与 c3 的主表对比。该计划对应论文第三章最核心的公开数据结果。",
  "_usage": "建议优先运行本文件；若要补齐第三章外部基线，请配合 configs/external/01_ch3_msl_external.json。",
  "_thesis_role": "第三章公开基准主结果",
  "_experiment_mapping": [
    "msl_mtadgat_baseline：原始 MTAD-GAT baseline。",
    "msl_c3_full：第三章完整模型，包含 Transformer 残差增强、状态感知调制、RevIN、质量感知融合和事件一致性。"
  ],
  "common_args": {
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "regime_emb_dim": 32,
    "regime_condition_mode": "transformer_residual",
    "regime_stat_features": "mean,std,last,delta",
    "event_low_ratio": 0.5,
    "event_min_length": 3,
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "msl_mtadgat_baseline",
      "comment": "MSL 主表 baseline。",
      "args": {
        "dataset": "MSL",
        "model_name": "mtad_gat",
        "run_id": "ch3_msl_mtadgat"
      }
    },
    {
      "name": "msl_c3_full",
      "comment": "MSL 主表 c3 完整模型。",
      "args": {
        "dataset": "MSL",
        "model_name": "mtad_gat_c3",
        "run_id": "ch3_msl_c3"
      }
    }
  ]
}

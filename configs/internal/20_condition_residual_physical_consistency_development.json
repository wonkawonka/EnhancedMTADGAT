{
  "plan_name": "20_condition_residual_physical_consistency_development",
  "_thesis_role": "Brand3 fold0层级开发：C3保持MTAD-GAT主干并进行正常工况残差校准；C4增加独立的瓶颈控制—响应物理一致性分数。",
  "_protocol": "沿用Zhang et al.论文车辆折、前200训练片段逐通道归一化、独立带标签校准折选择Top-p；工况残差分布及物理分数尺度只用正常validation拟合，不使用故障标签。",
  "_metric": "主指标AUROC与PR-AUC=Average Precision；先以同次推理中的scoring_variants验证C3>MTAD、C4>C3。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_transformer": false,
    "use_regime_condition": false,
    "use_revin": false,
    "score_fusion_mode": "quality_aware",
    "use_condition_residual_calibration": true,
    "condition_calibration_clusters": 12,
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_physical_response_features": false,
    "use_control_response_decoder": false,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407,
    "dataset": "TSINGHUA_EV",
    "model_name": "mtad_gat",
    "battery_brand": 3,
    "battery_fold": 0
  },
  "experiments": [
    {
      "name": "battery_c3_condition_residual_f0",
      "runner": "src.runners.train_nc_battery",
      "comment": "一次训练同时保存原始MTAD响应分数和C3工况标准化分数，严格成对比较。",
      "args": {
        "regime_aux_lambda": 0.0,
        "use_physical_consistency_head": false,
        "run_id": "c3_condition_residual_f0"
      }
    },
    {
      "name": "battery_c4_independent_physical_consistency_f0",
      "runner": "src.runners.train_nc_battery",
      "comment": "C4主干输出不被物理支路修改；低维状态+电流/SOC预测五个响应量，其残差只在评分端与C3融合。",
      "args": {
        "regime_aux_lambda": 1.0,
        "use_physical_consistency_head": true,
        "physical_consistency_hidden_dim": 64,
        "physical_consistency_latent_dim": 16,
        "physical_consistency_aux_weight": 1.0,
        "physical_consistency_kl_weight": 0.0001,
        "physical_consistency_score_max_weight": 0.35,
        "run_id": "c4_independent_physical_consistency_f0"
      }
    }
  ]
}

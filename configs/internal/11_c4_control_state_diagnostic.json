{
  "plan_name": "11_c4_control_state_diagnostic",
  "_thesis_role": "开发诊断，不进入正式主结果。物理状态仅使用可控量（相位、电流、累计电荷、SOC），避免把待检测的电压/温度响应重复作为状态输入。",
  "_protocol": "只运行 brand3/fold0 的 C4。参照为已完成的 06_kaggle_formal/battery_c3_b3_f0；仅加入零初始化门控的 controls_only 物理状态，保持 C3 fusion、共享路径初值和车辆协议一致。关闭物理正则与物理响应计分。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "strict_normal_validation",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_c4_control_state_only",
      "runner": "src.runners.train_nc_battery",
      "comment": "仅相对已完成 C3 fusion 参照加入 controls_only 的门控物理状态。",
      "matrix": {"battery_brand": [3], "battery_fold": [0]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "battery_score_channels": "response",
        "physical_state_feature_mode": "controls_only",
        "physical_state_injection_mode": "gated_residual",
        "use_physical_regularization": false,
        "use_physical_response_score": false,
        "run_id": "c4controlstate_battery_state_only"
      }
    }
  ]
}

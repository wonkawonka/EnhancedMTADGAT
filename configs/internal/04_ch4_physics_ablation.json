{
  "plan_name": "04_ch4_physics_ablation",
  "_thesis_role": "第四章相对第三章的递进、模块消融与响应项消融",
  "_comment": "同一数据划分和随机种子下先做C3到C4的加法式递进，再对完整C4按电压、温度、电荷流和SOC-电流响应组做留一消融。",
  "common_args": {
    "dataset": "TSINGHUA_EV",
    "model_name": "mtad_gat_c4_physics",
    "epochs": 50,
    "bs": 256,
    "lookback": 64,
    "window_stride": 4,
    "use_transformer": true,
    "use_revin": false,
    "use_regime_condition": true,
    "regime_encoder_type": "temporal",
    "regime_aux_lambda": 0.05,
    "regime_condition_mode": "fusion",
    "use_physical_state_encoding": true,
    "use_physical_regularization": true,
    "use_physical_response_score": true,
    "physical_alg_lambda": 0.1,
    "physical_smooth_lambda": 0.005,
    "physical_response_max_weight": 0.35,
    "physical_response_terms": "voltage_rate,temperature_rate,charge_flow,voltage_spread,temperature_spread,soc_current_coupling",
    "use_event_consistency": false,
    "normalize": true,
    "use_cuda": true,
    "require_cuda": true,
    "tsinghua_ev_validation_ratio": 0.15,
    "sample_score_top_ratio": 0.05,
    "early_stopping_patience": 8,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "c3_reference",
      "args": {
        "model_name": "mtad_gat_c3_regime",
        "use_physical_state_encoding": false,
        "use_physical_regularization": false,
        "use_physical_response_score": false,
        "run_id": "ch4prog_c3_reference"
      }
    },
    {
      "name": "c4_state_only",
      "args": {
        "use_physical_regularization": false,
        "use_physical_response_score": false,
        "run_id": "ch4prog_state_only"
      }
    },
    {
      "name": "c4_state_and_loss",
      "args": {
        "use_physical_response_score": false,
        "run_id": "ch4prog_state_loss"
      }
    },
    {"name": "c4_full", "args": {"run_id": "ch4prog_full"}},
    {
      "name": "c4_without_voltage_response",
      "args": {
        "physical_response_terms": "temperature_rate,charge_flow,temperature_spread,soc_current_coupling",
        "run_id": "ch4term_no_voltage"
      }
    },
    {
      "name": "c4_without_temperature_response",
      "args": {
        "physical_response_terms": "voltage_rate,charge_flow,voltage_spread,soc_current_coupling",
        "run_id": "ch4term_no_temperature"
      }
    },
    {
      "name": "c4_without_charge_flow",
      "args": {
        "physical_response_terms": "voltage_rate,temperature_rate,voltage_spread,temperature_spread,soc_current_coupling",
        "run_id": "ch4term_no_charge_flow"
      }
    },
    {
      "name": "c4_without_soc_current_coupling",
      "args": {
        "physical_response_terms": "voltage_rate,temperature_rate,charge_flow,voltage_spread,temperature_spread",
        "run_id": "ch4term_no_soc_current"
      }
    }
  ]
}

{
  "plan_name": "22_c3_long_horizon_operating_state_development",
  "_thesis_role": "C3开发验证：将短时电流/SOC控制轨迹与片段里程（无标签、因果的老化慢状态代理）联合为运行工况状态，在正常窗口上学习条件残差密度。",
  "_protocol": "Brand3 fold0开发；论文逐通道归一化与独立带标签校准折选Top-p。里程仅作为测试时可获得的元数据输入，残差专家只由正常validation拟合。",
  "_metric": "主指标AP；同一主干推理内严格配对比较MTAD-GAT response_channels与C3 condition_calibrated_response。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_transformer": false,
    "use_regime_condition": false,
    "use_revin": false,
    "score_fusion_mode": "quality_aware",
    "use_condition_residual_calibration": true,
    "condition_calibration_method": "soft_expert",
    "condition_calibration_clusters": 8,
    "condition_calibration_temperature": 1.0,
    "use_condition_slow_state": true,
    "use_physical_consistency_head": false,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407,
    "dataset": "TSINGHUA_EV",
    "model_name": "mtad_gat",
    "battery_brand": 3,
    "battery_fold": 0
  },
  "experiments": [
    {
      "name": "battery_c3_long_horizon_condition_f0",
      "runner": "src.runners.train_nc_battery",
      "comment": "真实工况状态：短时控制动态 + 无标签里程慢状态；软条件残差专家不使用响应变量。",
      "args": {"regime_aux_lambda": 0.0, "run_id": "c3_long_horizon_condition_f0"}
    }
  ]
}

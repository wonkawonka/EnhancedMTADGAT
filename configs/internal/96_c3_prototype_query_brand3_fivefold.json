{
  "plan_name": "96_c3_prototype_query_brand3_fivefold",
  "_thesis_role": "清华 EV Brand3 五折验证精简 C3：完整七通道统计 Token、原型 Query、软路由连续工况状态、融合 FiLM 与路由防坍缩损失。",
  "_protocol": "沿用 92 号计划的车辆级论文五折、归一化、Top-5% 和训练设置；只新增候选 C3 三臂，历史 baseline/restricted C3 不重复训练。",
  "_metric": "车辆级 AP 为主指标，AUROC 与低误报 TPR 为辅助指标；同时检查无防坍缩损失和状态打乱负对照。",
  "common_args": {
    "dataset": "TSINGHUA_EV",
    "battery_brand": 3,
    "battery_fold_seed": 0,
    "battery_split_protocol": "paper_protocol",
    "battery_normalization": "paper_channel",
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_vehicle_top_ratio_mode": "fixed",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "epochs": 30,
    "bs": 64,
    "lookback": 127,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "model_name": "mtad_gat",
    "regime_emb_dim": 8,
    "regime_encoder_type": "prototype_query",
    "regime_query_dim": 32,
    "regime_num_prototypes": 6,
    "regime_query_heads": 4,
    "regime_temperature": 0.5,
    "regime_film_scale": 0.1,
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "fixed",
    "use_c3_joint_relation": false,
    "use_relation_change_score": false,
    "use_condition_residual_calibration": false,
    "use_physical_consistency_head": false,
    "use_cuda": true,
    "require_cuda": true,
    "deterministic": true,
    "num_workers": 2,
    "predict_num_workers": 0,
    "persistent_workers": true,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "prototype_no_collapse_loss",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "use_regime_condition": true,
        "regime_condition_shuffle": false,
        "regime_prototype_lambda": 0.0,
        "run_id": "c3pq_no_collapse_loss"
      }
    },
    {
      "name": "prototype_full",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "use_regime_condition": true,
        "regime_condition_shuffle": false,
        "regime_prototype_lambda": 0.01,
        "run_id": "c3pq_full"
      }
    },
    {
      "name": "prototype_shuffled",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "use_regime_condition": true,
        "regime_condition_shuffle": true,
        "regime_prototype_lambda": 0.01,
        "run_id": "c3pq_shuffled"
      }
    },
     {
      "name": "baseline",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "use_regime_condition": false,
        "regime_aux_lambda": 0.0,
        "run_id": "c3r_baseline"
      }
    },
    {
      "name": "restricted_c3",
      "runner": "src.runners.train_nc_battery",
      "matrix": {"battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "regime_encoder_type": "restricted",
        "use_regime_condition": true,
        "regime_condition_shuffle": false,
        "regime_aux_lambda": 0.05,
        "run_id": "c3r_restricted"
      }
    }
  ]
}

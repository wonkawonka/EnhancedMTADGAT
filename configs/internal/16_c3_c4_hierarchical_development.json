{
  "plan_name": "16_c3_c4_hierarchical_development",
  "_thesis_role": "brand3 五折层级验证：C3体现工况条件化，C4在同一C3底座上增加物理控制—响应增强。",
  "_protocol": "沿用计划14/15的Zhang et al.论文协议：seed=0车辆五折、前200个训练片段逐通道归一化、独立带标签校准折选择片段阈值与车辆Top-p。复用计划14的MTAD-GAT和外部计划03的DyAD结果。",
  "_comparison": "主比较统一采用五个响应通道计分：C3对MTAD-GAT-response，C4对C3及DyAD；同次运行额外保存all-channel分数作补充。",
  "_metric": "主指标AUROC与PR-AUC=Average Precision。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 127,
    "battery_windows_per_snippet": 1,
    "battery_vehicle_top_ratio": 0.05,
    "battery_split_protocol": "paper_protocol",
    "battery_fold_seed": 0,
    "battery_normalization": "paper_channel",
    "battery_response_only_training": false,
    "battery_score_channels": "response",
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_revin": false,
    "regime_emb_dim": 32,
    "regime_encoder_type": "temporal",
    "regime_condition_mode": "fusion",
    "regime_aux_lambda": 0.05,
    "score_fusion_mode": "quality_aware",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "use_physical_response_score": false,
    "use_physical_response_features": false,
    "control_response_hidden_dim": 32,
    "control_response_aux_weight": 0.0,
    "use_cuda": true,
    "require_cuda": true,
    "num_workers": 4,
    "predict_num_workers": 4,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "battery_c3_joint_channels_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "C3：七通道联合预测/重构，共享MTAD-GAT关系学习，工况编码器在融合层进行FiLM条件化；以五个响应通道计分。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c3",
        "use_control_response_decoder": false,
        "run_id": "c3_joint_channels_paper_norm"
      }
    },
    {
      "name": "battery_c4_joint_control_response_paper_norm",
      "runner": "src.runners.train_nc_battery",
      "comment": "C4：保持C3七通道联合底座与工况FiLM不变，仅对五个响应输出叠加由电流/SOC历史驱动的因果控制—响应校正。",
      "matrix": {"battery_brand": [3], "battery_fold": [0, 1, 2, 3, 4]},
      "args": {
        "dataset": "TSINGHUA_EV",
        "model_name": "mtad_gat_c4_physics",
        "use_control_response_decoder": true,
        "run_id": "c4_joint_control_response_paper_norm"
      }
    }
  ]
}

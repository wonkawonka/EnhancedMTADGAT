{
  "plan_name": "85_c3_restricted_state_public_quick_validation",
  "_thesis_role": "冻结 C3：受约束 8-D 状态编码、融合表示 FiLM、状态语义辅助约束。",
  "_protocol": "MSL/SMAP、seed3407、10 epochs；四臂从头训练。真实/打乱 FiLM 验证状态配对，with/without auxiliary 验证状态语义约束。",
  "common_args": {
    "epochs": 10,
    "bs": 128,
    "lookback": 100,
    "window_stride": 1,
    "val_split": 0.1,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "model_name": "mtad_gat",
    "regime_emb_dim": 8,
    "regime_encoder_type": "restricted",
    "regime_condition_mode": "fusion",
    "regime_film_scale": 0.1,
    "score_fusion_mode": "fixed",
    "use_cuda": true,
    "require_cuda": true,
    "deterministic": true,
    "num_workers": 2,
    "predict_num_workers": 0,
    "persistent_workers": true,
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.0001,
    "log_tensorboard": false,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "baseline",
      "matrix": {"dataset": ["MSL", "SMAP"]},
      "args": {"use_regime_condition": false, "regime_aux_lambda": 0.0, "run_id": "c3r_baseline"}
    },
    {
      "name": "film_no_aux",
      "matrix": {"dataset": ["MSL", "SMAP"]},
      "args": {"use_regime_condition": true, "regime_condition_shuffle": false, "regime_aux_lambda": 0.0, "run_id": "c3r_film_no_aux"}
    },
    {
      "name": "film_true",
      "matrix": {"dataset": ["MSL", "SMAP"]},
      "args": {"use_regime_condition": true, "regime_condition_shuffle": false, "regime_aux_lambda": 0.05, "run_id": "c3r_film_true"}
    },
    {
      "name": "film_shuffled",
      "matrix": {"dataset": ["MSL", "SMAP"]},
      "args": {"use_regime_condition": true, "regime_condition_shuffle": true, "regime_aux_lambda": 0.05, "run_id": "c3r_film_shuffled"}
    }
  ]
}

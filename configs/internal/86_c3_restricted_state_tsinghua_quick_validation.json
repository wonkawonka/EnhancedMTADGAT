    {"name": "film_true_b3_f1", "runner": "src.runners.train_nc_battery", "args": {"use_regime_condition": true, "regime_condition_shuffle": false, "regime_aux_lambda": 0.05, "run_id": "c3r_tsinghua_film_true_b3_f1"}},
    {"name": "film_shuffled_b3_f1", "runner": "src.runners.train_nc_battery", "args": {"use_regime_condition": true, "regime_condition_shuffle": true, "regime_aux_lambda": 0.05, "run_id": "c3r_tsinghua_film_shuffled_b3_f1"}}

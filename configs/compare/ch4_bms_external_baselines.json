        "dataset": "BMS_B14_3_2_cluster1",
        "model": "TranAD"
      },
      "flags": [
        "retrain"
      ],
      "skip_if_exists": "checkpoints/TranAD_BMS_B14_3_2_cluster1/model.ckpt"
    },

{
  "plan_name": "ch_battery_physics_ablation",
  "_comment": "CH-BATTERY 物理增强消融计划：参照 ch4_bms_ablation 里 nasa_random 的模块拆分，只保留 phys_encoding_only 和 phys_reg_only 两组。",
  "_usage": "建议在 ch_battery_physics_main 跑完后执行；如果只看模块贡献，优先跑 phys_encoding_only。",
  "_output_layout": "固定输出到 experiment_runs/ch_battery_physics_ablation/output/<experiment_name>/。",
  "_experiment_mapping": [
    "chbatt_lfp_phys_encoding_only：仅启用时间步级物理状态编码。",
    "chbatt_lfp_phys_reg_only：仅启用物理正则化。"
  ],
  "common_args": {
    "dataset": "CH_BATTERY_LFP_DISCHARGE",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "window_stride": 4,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "model_name": "mtad_gat_c3",
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "physical_alg_lambda": 0.1,
    "physical_smooth_lambda": 0.01,
    "ch_battery_preprocessed_dir": "datasets/CH-BATTERY/processed/lfp_discharge",
    "ch_battery_train_ratio": 0.8,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "chbatt_lfp_phys_encoding_only",
      "comment": "CH-BATTERY 物理消融：仅启用物理状态编码。",
      "args": {
        "use_physical_state_encoding": true,
        "use_physical_regularization": false,
        "run_id": "chbatt_phys_abl_enc"
      }
    },
    {
      "name": "chbatt_lfp_phys_reg_only",
      "comment": "CH-BATTERY 物理消融：仅启用物理正则化。",
      "args": {
        "use_physical_state_encoding": false,
        "use_physical_regularization": true,
        "run_id": "chbatt_phys_abl_reg"
      }
    }
  ]
}

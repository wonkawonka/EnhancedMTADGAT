{
  "plan_name": "mtadgat_full_experiments",
  "common_args": {
    "model_name": "mtad_gat",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "window_stride": 1,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "regime_emb_dim": 32,
    "regime_condition_mode": "transformer_residual",

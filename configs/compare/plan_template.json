    "event_low_ratio": 0.5,
    "event_min_length": 3,
    "hier_score_weight": 0.5,
    "use_physical_state_encoding": false,
    "use_physical_regularization": false,
    "physical_alg_lambda": 0.1,
    "physical_smooth_lambda": 0.01,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [

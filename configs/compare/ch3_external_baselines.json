{
  "plan_name": "ch3_external_baselines",
  "_comment": "第三章外部基线计划（精简版）。仅保留 SMAP 和 MSL 的外部基线对比，聚焦有标签主表结论。",
  "_usage": "建议先 dry-run 检查命令：python run_external_baselines.py --plan configs/compare/ch3_external_baselines.json --dry-run",
  "_ready_now": [
    "TranAD、Anomaly-Transformer、GDN、DCdetector 已适配主仓 processed 数据。",
    "GDN 设备参数统一为 cuda，与本地主实验 GPU 设置一致。"
  ],
  "_pending_now": [
    "GANF 因训练轮数长且论文增益有限，默认移出精简计划。"
  ],
  "_thesis_scope_note": "本计划用于第三章外部对比：SMAP/MSL 做主表指标比较。",
  "common_env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "experiments": [
    {
      "name": "tranad_smap_ch3",
      "baseline": "TranAD",
      "script": "main.py",
      "args": {
        "dataset": "SMAP",
        "model": "TranAD"
      },
      "flags": [
        "retrain"
      ],
      "skip_if_exists": "checkpoints/TranAD_SMAP/model.ckpt"
    },
    {
      "name": "anomaly_transformer_smap_ch3",
      "baseline": "Anomaly-Transformer",
      "script": "main.py",
      "args": {
        "dataset": "SMAP",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_smap",
        "input_c": 25,
        "output_c": 25,
        "num_epochs": 10,
        "batch_size": 256,
        "win_size": 100,
        "anormly_ratio": 4.0
      },
      "skip_if_exists": "checkpoints/ch3_smap/SMAP_checkpoint.pth"
    },
    {
      "name": "gdn_smap_ch3",
      "baseline": "GDN",
      "script": "main.py",
      "args": {
        "-dataset": "smap",
        "-device": "cuda",
        "-epoch": 10,
        "-batch": 128,
        "-slide_win": 15,
        "-slide_stride": 5,
        "-save_path_pattern": "ch3_gdn_smap"
      },
      "skip_if_exists": "pretrained/ch3_gdn_smap"
    },
    {
      "name": "tranad_msl_ch3",
      "baseline": "TranAD",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "model": "TranAD"
      },
      "flags": [
        "retrain"
      ],
      "skip_if_exists": "checkpoints/TranAD_MSL/model.ckpt"
    },
    {
      "name": "anomaly_transformer_msl_ch3",
      "baseline": "Anomaly-Transformer",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_msl",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 256,
        "win_size": 100,
        "anormly_ratio": 4.0
      },
      "skip_if_exists": "checkpoints/ch3_msl/MSL_checkpoint.pth"
    },
    {
      "name": "gdn_msl_ch3",
      "baseline": "GDN",
      "script": "main.py",
      "args": {
        "-dataset": "msl",
        "-device": "cuda",
        "-epoch": 10,
        "-batch": 128,
        "-slide_win": 15,
        "-slide_stride": 5,
        "-save_path_pattern": "ch3_gdn_msl"
      },
      "skip_if_exists": "pretrained/ch3_gdn_msl"
    },
    {
      "name": "dcdetector_smap_ch3",
      "baseline": "DCdetector",
      "script": "main.py",
      "args": {
        "dataset": "SMAP",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_dcdetector_smap",
        "input_c": 25,
        "output_c": 25,
        "num_epochs": 10,
        "batch_size": 128,
        "win_size": 100,
        "patch_size": "[5]",
        "anormly_ratio": 4.0,
        "lr": 1e-4
      },
      "skip_if_exists": "checkpoints/ch3_dcdetector_smap/SMAP_checkpoint.pth"
    },
    {
      "name": "dcdetector_msl_ch3",
      "baseline": "DCdetector",
      "script": "main.py",
      "args": {
        "dataset": "MSL",
        "mode": "train",
        "data_path": ".",
        "model_save_path": "./checkpoints/ch3_dcdetector_msl",
        "input_c": 55,
        "output_c": 55,
        "num_epochs": 10,
        "batch_size": 128,
        "win_size": 100,
        "patch_size": "[5]",
        "anormly_ratio": 4.0,
        "lr": 1e-4
      },
      "skip_if_exists": "checkpoints/ch3_dcdetector_msl/MSL_checkpoint.pth"
    }
  ]
}

{
  "plan_name": "ch_battery_physics_main",
  "_comment": "CH-BATTERY 物理增强主结果计划：参照 ch4_bms_main 里 nasa_random 的用法，只在 c3 主干上增加物理状态编码与物理正则化，不引入 BMS 专属层级一致性分支。",
  "_usage": "建议在 ch_battery_main 跑通后执行；主要用于第四章补充说明物理增强在外部电池故障数据上的效果。",
  "_output_layout": "固定输出到 experiment_runs/ch_battery_physics_main/output/<experiment_name>/。",
  "_experiment_mapping": [
    "chbatt_lfp_c3_physics：CH-BATTERY LFP discharge 上的 c3 + physical_state_encoding + physical_regularization。"
  ],
  "common_args": {
    "dataset": "CH_BATTERY_LFP_DISCHARGE",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "window_stride": 8,
    "feature_att_trans": false,
    "multi_scale_mode": "none",
    "use_physical_state_encoding": true,
    "use_physical_regularization": true,
    "physical_alg_lambda": 0.1,
    "physical_smooth_lambda": 0.01,
    "ch_battery_preprocessed_dir": "datasets/CH-BATTERY/processed/lfp_discharge",
    "ch_battery_train_ratio": 0.8,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "num_workers": 4,
    "persistent_workers": true,
    "prefetch_factor": 4,
    "predict_batch_size": 256,
    "predict_num_workers": 2,
    "predict_pin_memory": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "chbatt_lfp_c3_physics",
      "comment": "CH-BATTERY 物理增强主结果。",
      "args": {
        "model_name": "mtad_gat_c3",
        "run_id": "chbatt_phys_c3"
      }
    }
  ]
}

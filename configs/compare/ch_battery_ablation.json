{
  "plan_name": "ch_battery_ablation",
  "_comment": "CH-BATTERY 模块消融计划：参照 ch3_battery_ablation 里 nasa_random 的思路，只保留最关键的 no_transformer / no_regime / no_revin 三组。",
  "_usage": "建议在 ch_battery_main 跑完后再运行；如果预算有限，可先只跑 no_regime。",
  "_output_layout": "固定输出到 experiment_runs/ch_battery_ablation/output/<experiment_name>/。",
  "_experiment_mapping": [
    "chbatt_lfp_c3_no_transformer：关闭 Transformer 残差分支，并将工况注入切回 fusion。",
    "chbatt_lfp_c3_no_regime：关闭工况感知关系建模。",
    "chbatt_lfp_c3_no_revin：关闭 RevIN。"
  ],
  "common_args": {
    "dataset": "CH_BATTERY_LFP_DISCHARGE",
    "model_name": "mtad_gat_c3",
    "epochs": 30,
    "bs": 256,
    "lookback": 100,
    "window_stride": 8,
    "use_transformer": true,
    "use_revin": true,
    "use_regime_condition": true,
    "regime_condition_mode": "transformer_residual",
    "score_fusion_mode": "quality_aware",
    "use_event_consistency": true,
    "ch_battery_preprocessed_dir": "datasets/CH-BATTERY/processed/lfp_discharge",
    "ch_battery_train_ratio": 0.8,
    "normalize": true,
    "init_lr": 0.001,
    "dropout": 0.3,
    "use_cuda": true,
    "num_workers": 4,
    "persistent_workers": true,
    "prefetch_factor": 4,
    "predict_batch_size": 256,
    "predict_num_workers": 2,
    "predict_pin_memory": true,
    "log_tensorboard": false,
    "print_every": 1,
    "seed": 3407
  },
  "experiments": [
    {
      "name": "chbatt_lfp_c3_no_transformer",
      "comment": "CH-BATTERY 消融：关闭 Transformer 残差分支，并切回 fusion。",
      "args": {
        "model_name": "mtad_gat",
        "use_transformer": false,
        "regime_condition_mode": "fusion",
        "run_id": "chbatt_abl_no_transformer"
      }
    },
    {
      "name": "chbatt_lfp_c3_no_regime",
      "comment": "CH-BATTERY 消融：关闭工况感知关系建模。",
      "args": {
        "model_name": "mtad_gat",
        "use_regime_condition": false,
        "run_id": "chbatt_abl_no_regime"
      }
    },
    {
      "name": "chbatt_lfp_c3_no_revin",
      "comment": "CH-BATTERY 消融：关闭 RevIN。",
      "args": {
        "model_name": "mtad_gat_c3",
        "use_revin": false,
        "run_id": "chbatt_abl_no_revin"
      }
    }
  ]
}
